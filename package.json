{
  "name": "sonarr",
  "version": "1.0.0",
  "description": "",
  "main": "a.js",
  "engines": {
    "node": ">=24",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "services:up": "docker compose -f src/infra/docker/compose.yml up -d",
    "services:down": "docker compose -f src/infra/docker/compose.yml down",
    "rebuild:approved": "npm rebuild @nestjs/core @prisma/client @prisma/engines prisma protobufjs unrs-resolver msgpackr-extract --foreground-scripts --ignore-scripts=false",
    "lint": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "migration:push": "npx dotenv -e .env.development -- npx prisma db push",
    "test:nest": "jest --config jest.config.ts",
    "test:nest:coverage": "jest --config jest.config.ts --coverage",
    "test:ci": "jest --config jest.config.ts --selectProjects unit --runInBand",
    "test:ci:coverage": "jest --config jest.config.ts --selectProjects unit --runInBand --coverage",
    "build": "nest build",
    "start:prod": "node --import ./dist/telemetry.js dist/main",
    "start:dev": "nest start --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
